# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave the VITE_ values empty to run the app in demo mode (fake data saved in your browser).

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel function api/submit-photo) — never prefix these with VITE_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Paste the whole service account JSON key on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID at the end of the Shared Drive folder URL: drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_FOLDER_ID=
