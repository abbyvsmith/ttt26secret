# Copy to .env.local for local dev. On Vercel, the Supabase integration's NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY are used instead (or set these two names there yourself).
# Leave them empty to run the app in demo mode (fake data saved in your browser).
# Both are safe to expose in the browser; access is enforced by the rules in supabase/schema.sql.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
